{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommProbe-Custom-Desktop",
  "version": "0.1.5",
  "identifier": "com.xiaohutao.commprobe.custom",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CommProbe-Custom-Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../desktop-backend/target/commprobe-backend.jar": "backend/commprobe-backend.jar",
      "../build/java-runtime/": "java-runtime/",
      "../LICENSE": "licenses/COMM-PROBE-MIT.txt",
      "../third-party/": "licenses/third-party/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
